# Copy to .env and fill in. Never commit .env.

# Enables AI answer evaluation. Without it the app still works using an offline keyword evaluator.
GROQ_API_KEY=

# Model used for evaluation (change if you want a cheaper/faster one).
EVAL_MODEL=openai/gpt-oss-120b

# Optional: fixed secret for session cookies (otherwise one is generated in instance/.secret_key).
# SECRET_KEY=
# Set to 1 when serving over HTTPS.
# SESSION_COOKIE_SECURE=1
